# =============================================================
#  boletines/  ->  SOLO archivos PDF subidos desde el panel.
#  El motor PHP queda apagado: nada se ejecuta en esta carpeta.
# =============================================================

<IfModule php_module>
    php_flag engine off
</IfModule>

<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .pl .py .cgi .asp .aspx .sh
    RemoveType .php .phtml .phar .phps
</IfModule>

<FilesMatch "(?i)\.(php[0-9]?|phtml|phps|phar|pht|pl|py|cgi|asp|aspx|jsp|sh|bash|lua|exe|com|dll|ini)$">
    Require all denied
</FilesMatch>
